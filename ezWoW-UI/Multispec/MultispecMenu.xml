<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">
    <Button name="EzWoWPremiumSpecButton" virtual="true">
		<Size x="32" y="32"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBackground" file="Interface\SpellBook\SpellBook-SkillLineTab">
					<Size x="64" y="64"/>
					<Anchors>
						<Anchor point="TOPLEFT">
							<Offset x="-3" y="11"/>
						</Anchor>
					</Anchors>
				</Texture>
			</Layer>
        </Layers>
        <Anchors>
            <Anchor point="BOTTOMLEFT" relativePoint="BOTTOMRIGHT" x="32"/>
        </Anchors>
        <NormalTexture name="$parentNormalTexture" file="Interface\Icons\Spell_ChargePositive"/>
        <HighlightTexture file="Interface\Buttons\ButtonHilight-Square" alphaMode="ADD"/>
		<Scripts>
			<OnClick function="EzWoWMultispecMenu_ToggleContextMenu"/>
		</Scripts>
    </Button>

	<Frame name="EzWoWMultispecDropDownMenu" inherits="UIDropDownMenuTemplate">
       	<Scripts>
        	<OnLoad>
            	UIDropDownMenu_Initialize(self, EzWoWMultispecDropDownMenu_OnLoad, "MENU");
           	</OnLoad>
       	</Scripts>
   </Frame>
</Ui>