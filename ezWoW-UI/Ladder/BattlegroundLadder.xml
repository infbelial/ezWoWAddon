<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\FrameXML\UI.xsd">

	<Frame name="EzWoWBattlegroundLadderRowTemplate" virtual="true">
		<Size x="100" y="22"/>
		<Layers>
			<Layer level="ARTWORK">
				<!-- stats, from right to left -->
				<FontString name="$parentDeaths" parentKey="playerDeaths" inherits="GameFontWhite">
					<Size x="50" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" x="-4"/>
					</Anchors>
				</FontString>
				<FontString name="$parentAssists" parentKey="playerAssists" inherits="GameFontWhite">
					<Size x="50" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentDeaths" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentKills" parentKey="playerKills" inherits="GameFontWhite">
					<Size x="54" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentAssists" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentLeaves" parentKey="playerLeaves" inherits="GameFontWhite">
					<Size x="54" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentKills" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentDraws" parentKey="playerDraws" inherits="GameFontWhite">
					<Size x="50" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentLeaves" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentWinRate" parentKey="playerWinRate" inherits="GameFontWhite">
					<Size x="42" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentDraws" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentWinsLosses" parentKey="playerWinsLosses" inherits="GameFontWhite" justifyH="CENTER">
					<Size x="60" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentWinRate" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<FontString name="$parentRating" parentKey="playerRating" inherits="GameFontWhite">
					<Size x="45" y="20"/>
					<Anchors>
						<Anchor point="RIGHT" relativeTo="$parentWinsLosses" relativePoint="LEFT"/>
					</Anchors>
				</FontString>
				<!-- character info, from left to right-->
				<FontString name="$parentRank" parentKey="playerRank" justifyH="CENTER" inherits="GameFontWhite">
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</FontString>
				<Texture name="$parentFaction" parentKey="playerFaction" file="Interface\GLUES\CHARACTERCREATE\UI-CharacterCreate-Factions">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentRank" relativePoint="RIGHT"/>
					</Anchors>
				</Texture>
				<Texture name="$parentRace" parentKey="playerRace" file="Interface\GLUES\CHARACTERCREATE\UI-CharacterCreate-Races">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentFaction" relativePoint="RIGHT"/>
					</Anchors>
					<TexCoords left="0.0" right="0.125" top="0.0" bottom="0.25"/>
				</Texture>
				<Texture name="$parentClass" parentKey="playerClass" file="Interface\GLUES\CHARACTERCREATE\UI-CHARACTERCREATE-CLASSES">
					<Size x="20" y="20"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentRace" relativePoint="RIGHT"/>
					</Anchors>
					<TexCoords top="0.0" bottom="0.25" left="0.0" right="0.25"/>
				</Texture>
				<FontString name="$parentName" parentKey="playerName" inherits="GameFontWhite">
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentClass" relativePoint="RIGHT" x="4"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="BACKGROUND">
			   	<Texture parentKey="background" file="Interface\AddOns\ezWoW\Textures\ListButtons">
				   	<TexCoords left="0.00390625" right="0.8203125" top="0.00390625" bottom="0.18359375"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Frame name="EzWoWBattlegroundLadderPanel" parent="EzWoWLadderFrame" setAllPoints="true">
		<Layers>
			<Layer level="OVERLAY">
				<FontString inherits="GameFontNormalSmall" parentKey="seasonEnd" justifyH="RIGHT">
					<Anchors>
						<Anchor point="TOPRIGHT" y="-30" x="-12"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Frames>
			<Button name="$parentTab1" inherits="TabButtonTemplate" text="EZTEXT_LADDER" id="1" frameLevel="5" parentArray="Tabs">
				<Anchors>
					<Anchor point="TOPLEFT" x="58" y="-28"/>
				</Anchors>
				<Scripts>
					<OnLoad function="EzWoWLadderInnerTab_OnLoad"/>
					<OnClick function="EzWoWBattlegroundLadderTab_OnClick"/>
				</Scripts>
			</Button>
			<Button name="$parentTab2" inherits="TabButtonTemplate" text="EZTEXT_LADDER_HISTORY" id="2" frameLevel="5" parentArray="Tabs">
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentTab1" relativePoint="RIGHT"/>
				</Anchors>
				<Scripts>
					<OnLoad function="EzWoWLadderInnerTab_OnLoad"/>
					<OnClick function="EzWoWBattlegroundLadderTab_OnClick"/>
				</Scripts>
			</Button>
			<!--Button name="$parentTab3" inherits="TabButtonTemplate" text="Награды" id="3" frameLevel="5" parentArray="Tabs">
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentTab2" relativePoint="RIGHT"/>
				</Anchors>
				<Scripts>
					<OnLoad function="EzWoWLadderInnerTab_OnLoad"/>
					<OnClick function="EzWoWBattlegroundLadderTab_OnClick"/>
				</Scripts>
			</Button-->
		</Frames>
		<Scripts>
			<OnLoad>
				self.numTabs = 2
				PanelTemplates_SetTab(self, 1)
			</OnLoad>
			<OnShow function="EzWoWBattlegroundLadderPanel_OnShow"/>
		</Scripts>
	</Frame>

    <Frame name="EzWoWBattlegroundLadder" parent="EzWoWBattlegroundLadderPanel">
		<Anchors>
			<Anchor point="TOPLEFT" y="-35"/>
			<Anchor point="TOPRIGHT" y="-35"/>
			<Anchor point="BOTTOMLEFT"/>
			<Anchor point="BOTTOMRIGHT"/>
		</Anchors>
		<Frames>
			<Frame name="$parentTableHeader">
				<Size x="300" y="54"/>
				<Anchors>
					<Anchor point="TOPLEFT" x="5" y="-25"/>
					<Anchor point="TOPRIGHT" x="-8" y="-25"/>
				</Anchors>
				<Layers>
					<Layer level="BACKGROUND">
						<Texture name="$parentBg" file="Interface\AddOns\ezModeration\Textures\UI-Background-Marble" horizTile="true" vertTile="true">
							<Anchors>
								<Anchor point="TOPLEFT"/>
								<Anchor point="BOTTOMRIGHT"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="BORDER">
						<Texture name="$parentInsetTopLeftCorner" inherits="EzWoW-UI-Frame-InnerTopLeft">
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentBg"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetTopRightCorner" inherits="EzWoW-UI-Frame-InnerTopRight">
							<Anchors>
								<Anchor point="TOPRIGHT" relativeTo="$parentBg"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetTopBorder" inherits="EzWoW-UI-Frame-InnerTopTile">
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentInsetTopLeftCorner" relativePoint="TOPRIGHT"/>
								<Anchor point="TOPRIGHT" relativeTo="$parentInsetTopRightCorner" relativePoint="TOPLEFT"/>
							</Anchors>
						</Texture>
						<Texture name="$parentInsetLeftBorder" inherits="EzWoW-UI-Frame-InnerLeftTile">
							<Anchors>
								<Anchor point="TOPLEFT" relativeTo="$parentInsetTopLeftCorner" relativePoint="BOTTOMLEFT" x="0" y="0" />
							</Anchors>
						</Texture>
						<Texture name="$parentInsetRightBorder" inherits="EzWoW-UI-Frame-InnerRightTile">
							<Anchors>
								<Anchor point="TOPRIGHT" relativeTo="$parentInsetTopRightCorner" relativePoint="BOTTOMRIGHT"/>
							</Anchors>
						</Texture>
					</Layer>
					<Layer level="ARTWORK">
						<FontString name="$parentDeaths" inherits="GameFontWhiteSmall" text="EZTEXT_DEATHS">
							<Size x="50" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" x="-4"/>
							</Anchors>
						</FontString>
						<FontString name="$parentAssists" inherits="GameFontWhiteSmall" text="EZTEXT_ASSISTS">
							<Size x="50" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentDeaths" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<FontString name="$parentKills" inherits="GameFontWhiteSmall" text="EZTEXT_KILLS">
							<Size x="54" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentAssists" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<FontString name="$parentLeaves" inherits="GameFontWhiteSmall" text="EZTEXT_LEAVES">
							<Size x="54" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentKills" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<FontString name="$parentDraws" inherits="GameFontWhiteSmall" text="EZTEXT_DRAWS">
							<Size x="50" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentLeaves" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<FontString name="$parentWinsLosses" inherits="GameFontWhiteSmall" text="EZTEXT_WINS_LOSSES">
							<Size x="102" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentDraws" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<FontString name="$parentRating" inherits="GameFontWhiteSmall" text="EZTEXT_RATING">
							<Size x="45" y="30"/>
							<Anchors>
								<Anchor point="RIGHT" relativeTo="$parentWinsLosses" relativePoint="LEFT"/>
							</Anchors>
						</FontString>
						<!-- -->
						<FontString name="$parentRank" parentKey="rank" inherits="GameFontWhite" text="#">
							<Size x="20" y="30"/>
							<Anchors>
								<Anchor point="TOPLEFT" x="4"/>
							</Anchors>
						</FontString>
						<FontString name="$parentCharacter" inherits="GameFontWhite" text="EZTEXT_CHARACTER">
							<Size x="100" y="30"/>
							<Anchors>
								<Anchor point="LEFT" relativeTo="$parentRank" relativePoint="RIGHT" x="4"/>
								<Anchor point="RIGHT" relativeTo="$parentRating" relativePoint="LEFT" x="-4"/>
							</Anchors>
						</FontString>
					</Layer>
				</Layers>
				<Frames>
					<Frame name="EzWoWBattlegroundLadderCharacterRow" inherits="EzWoWBattlegroundLadderRowTemplate">
						<Anchors>
							<Anchor point="TOPLEFT" x="4" y="-30"/>
							<Anchor point="TOPRIGHT" x="-4"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
			<Frame name="$parentTable" parentKey="table" inherits="EzWoWLadderTable">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="$parentTableHeader" relativePoint="BOTTOMLEFT" y="-4"/>
					<Anchor point="BOTTOMRIGHT" x="-8" y="38"/>
				</Anchors>
			</Frame>
			<Frame name="$parentNavigation" parentKey="navigation" inherits="EzWoWLadderNavigation">
				<Size x="200" y ="32"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-6" y="4"/>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad function="EzWoWBattlegroundLadder_OnLoad"/>
			<OnShow function="EzWoWBattlegroundLadder_OnShow"/>
			<OnMouseDown>self.navigation.pageNum:ClearFocus()</OnMouseDown>
			<OnUpdate function="EzWoWLadder_OnUpdate"/>
		</Scripts>
	</Frame>

	<Frame name="EzWoWBattlegroundHistory" parent="EzWoWBattlegroundLadderPanel" hidden="true" inherits="EzWoWLadderHistoryTemplate">
		<Anchors>
			<Anchor point="TOPLEFT" y="-60"/>
			<Anchor point="TOPRIGHT" y="-60"/>
			<Anchor point="BOTTOMLEFT"/>
			<Anchor point="BOTTOMRIGHT"/>
		</Anchors>
		<Scripts>
			<OnLoad function="EzWoWBattlegroundHistory_OnLoad"/>
			<OnShow function="EzWoWBattlegroundHistory_Update"/>
		</Scripts>
	</Frame>
</Ui>